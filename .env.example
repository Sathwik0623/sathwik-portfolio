DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# Direct (non-pooled) connection used by the Prisma CLI for migrations. If your
# provider fronts the database with a connection pooler (e.g. Supabase's
# transaction pooler on DATABASE_URL), set this to the direct/session connection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
ADMIN_PASSWORD="change-me-before-deploying"
ADMIN_SESSION_SECRET="generate-a-random-32-byte-base64-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
