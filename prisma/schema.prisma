generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Visitor {
  id          String   @id @default(cuid())
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  isReturning Boolean  @default(false)
  events      Event[]
}

model Session {
  id         String    @id @default(cuid())
  visitorId  String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  durationMs Int?
  referrer   String?
  utmSource  String?
  deviceType String?
  events     Event[]
}

model Event {
  id        String   @id @default(cuid())
  name      String
  path      String?
  metadata  String?
  createdAt DateTime @default(now())
  visitorId String
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  visitor   Visitor  @relation(fields: [visitorId], references: [id])

  @@index([name])
  @@index([createdAt])
}

model ContactLead {
  id        String           @id @default(cuid())
  name      String
  email     String
  linkedin  String?
  message   String?
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())
}

model Media {
  id                       String         @id @default(cuid())
  filename                 String
  url                      String
  mimeType                 String
  kind                     MediaKind
  size                     Int
  altText                  String?
  description              String?
  createdAt                DateTime       @default(now())
  achievementCertificateOf Achievement[]  @relation("AchievementCertificate")
  achievementPhotoOf       Achievement[]  @relation("AchievementPhoto")
  articleCoverOf           Article?
  certification            Certification?
  resume                   Resume?
}

model Profile {
  id          String   @id @default("profile")
  name        String
  headline    String
  proofLine   String
  summary     String
  location    String
  email       String
  githubUrl   String?
  linkedinUrl String?
  heroVisible Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Settings {
  id                   String   @id @default("settings")
  heroProofLineVisible Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model Experience {
  id         String        @id @default(cuid())
  role       String
  company    String
  companyUrl String?
  startDate  String
  endDate    String?
  current    Boolean       @default(false)
  summary    String
  highlights String
  tech       String
  order      Int           @default(0)
  status     ContentStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  logoUrl    String?
}

model Project {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  tagline         String
  badge           String?
  period          String?
  problem         String
  solution        String
  architecture    String?
  tech            String
  contributions   String
  results         String
  githubUrl       String?
  demoUrl         String?
  featured        Boolean       @default(false)
  pressCoverage   Boolean       @default(false)
  certificateNote String?
  order           Int           @default(0)
  status          ContentStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  achievements    Achievement[]
}

model Achievement {
  id                  String        @id @default(cuid())
  title               String
  meta                String?
  category            String?
  description         String
  detailedDescription String?
  organization        String?
  achievementType     String?
  year                String?
  link                String?
  linkLabel           String?
  featured            Boolean       @default(false)
  order               Int           @default(0)
  status              ContentStatus @default(DRAFT)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  projectId           String?
  certificateMediaId  String?
  photoMediaId        String?
  certificateMedia    Media?        @relation("AchievementCertificate", fields: [certificateMediaId], references: [id])
  photoMedia          Media?        @relation("AchievementPhoto", fields: [photoMediaId], references: [id])
  project             Project?      @relation(fields: [projectId], references: [id])
}

model Certification {
  id            String        @id @default(cuid())
  name          String
  issuer        String
  issued        String?
  credentialId  String?
  credentialUrl String?
  description   String?
  order         Int           @default(0)
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  mediaId       String?       @unique
  media         Media?        @relation(fields: [mediaId], references: [id])
}

model Skill {
  id        String        @id @default(cuid())
  name      String
  category  String
  order     Int           @default(0)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Education {
  id          String        @id @default(cuid())
  institution String
  degree      String
  field       String?
  startDate   String
  endDate     String
  gpa         String?
  description String?
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Resume {
  id         String   @id @default(cuid())
  mediaId    String   @unique
  isCurrent  Boolean  @default(false)
  uploadedAt DateTime @default(now())
  media      Media    @relation(fields: [mediaId], references: [id])
}

model CodingProfile {
  id        String        @id @default(cuid())
  platform  String
  username  String
  url       String
  order     Int           @default(0)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Article {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  summary      String
  content      String?
  tags         String
  publishedAt  DateTime?
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  coverMediaId String?       @unique
  coverMedia   Media?        @relation(fields: [coverMediaId], references: [id])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  NEW
  READ
  CONTACTED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  PDF
}
